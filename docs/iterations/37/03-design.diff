+def test_band_percentile():
+    # 最近序位法：由小到大第 ceil(P × n ÷ 100) 個
+    vals = [float(v) for v in range(1, 201)]                         # 1～200
+    rows = [(D0 + timedelta(days=i), v * 5, v, 2.0) for i, v in enumerate(vals)]
