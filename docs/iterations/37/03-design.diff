+    assert last == days[-1] and sv["1111"] == export.stock_valuation({"pe": [20.0] * 130, "pb": [2.0] * 130, "dy": [3.0] * 130}, {"pe": 20.0, "pb": 2.0, "dy": 3.0})
+    assert band["1111"]["pe"]["s"] == [[str(days[0]), 5.0]] and band["2222"] == {"pb": {"s": [[str(days[1]), 20.0]], "k": [1.5] * 5, "n": 130}}
