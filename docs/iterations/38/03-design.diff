+def _w(s):
+    """顯示寬度（全形字 = 1，半形約 0.55）；標籤 ≤ 11 才能在 1024／375 一行放下（38/01 Q38-1）。"""
+    return sum(1 if ord(c) > 0x2E7F else 0.55 for c in s)
