+def bs_roe(cum: dict, bal: dict, y: int, q: int) -> tuple:
+    """(ROE %, 原因)：近 4 季淨利 ÷（一年前同季底 + 本季底權益）÷ 2；依序 c 本季沒有權益、a 沒有一年前同季權益、i 近 4 季淨利不足、e 平均 ≤ 0。"""
+    e1 = bs_equity(bal.get((y, q)))
+    if e1 is None:
+        return None, "c"
+    e0 = bs_equity(bal.get((y - 1, q)))
+    if e0 is None:
+        return None, "a"
+    ni = fin_ni4(cum, y, q)
+    if ni is None:
+        return None, "i"
+    if e0 + e1 <= 0:
+        return None, "e"
+    return _r1(ni * 2, e0 + e1), None
+
