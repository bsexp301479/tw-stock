+        rows.append([show, _f(c), _f(ch), _f(_pct(c, ch)), _f(ret(c, b5)), _f(ret(c, b20))])
+    site = sorted(industries - {SX_ALIAS.get(r[0], r[0]) for r in rows})
+    return {"d": str(d), "b5": b5 and str(b5), "b20": b20 and str(b20), "r": rows}, off, site
