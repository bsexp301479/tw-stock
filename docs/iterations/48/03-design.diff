+// 一條線：起點 b 到終點每個交易日 [日期, %, 無成交]（無成交沿用之前的值，R65）；統計只用起點那一點＋之後有成交的日子
+function cmpLine(days, d_, adj, b) {
+  const base = cmpAt(d_, adj, b), at = {}, pts = [base];
